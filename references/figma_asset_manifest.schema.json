{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "figmaFile": {
      "type": "string"
    },
    "rootNodeId": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "figmaName": {
            "type": "string",
            "minLength": 1
          },
          "assetType": {
            "enum": [
              "bg",
              "panel",
              "btn",
              "icon",
              "card",
              "deco",
              "illustration"
            ]
          },
          "fileName": {
            "type": "string",
            "minLength": 1
          },
          "unityPath": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "png",
              "svg"
            ]
          },
          "scaleFactor": {
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "sourceBounds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "alphaRequired": {
            "type": "boolean"
          },
          "nineSlice": {
            "type": "boolean"
          },
          "border": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "notes": {
            "type": "string"
          },
          "filterMode": {
            "enum": [
              "Bilinear",
              "Point",
              "Trilinear"
            ]
          },
          "backgroundColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "alphaPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowCornerAlpha": {
                "type": "boolean"
              },
              "allowedTouchingEdges": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "left",
                    "right",
                    "top",
                    "bottom"
                  ]
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        "required": [
          "nodeId",
          "figmaName",
          "assetType",
          "fileName",
          "unityPath",
          "format",
          "scaleFactor",
          "sourceBounds",
          "alphaRequired",
          "nineSlice"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "figmaFile",
    "rootNodeId",
    "assets"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
